# =====================================================================
# VidSage - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file containing real API keys to version control.
# =====================================================================

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Vector Database (Qdrant Cloud or Local)
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Local Runtime Root (Default: ~/.ytrag)
YTRAG_ROOT=~/.ytrag

# Whisper Transcription Settings
YTRAG_WHISPER_MODEL=large-v3
YTRAG_WHISPER_DEVICE=auto
YTRAG_WHISPER_COMPUTE_TYPE=auto
YTRAG_WHISPER_BATCH=8
YTRAG_WHISPER_BEAM=5
YTRAG_WHISPER_LANG=en

# Embedding Model
YTRAG_EMBED_MODEL=BAAI/bge-m3

# Qdrant Collection Name
YTRAG_COLLECTION=dsa_lectures_1024

# Chunking Configuration (Time-based in seconds)
YTRAG_CHUNK_SECONDS=75
YTRAG_CHUNK_OVERLAP=15

# Retrieval Configuration
YTRAG_TOP_K=6
YTRAG_MAX_DISTANCE=0.5

# LLM Generation Model
YTRAG_LLM_MODEL=openai/gpt-oss-120b

# API Rate Limiting & Safety
YTRAG_RATE_LIMIT_REQUESTS=30
YTRAG_RATE_LIMIT_WINDOW=60
YTRAG_MAX_QUESTION_CHARS=1000
